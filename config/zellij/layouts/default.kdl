// Default workspace layout.
// One tall "main" pane on the left; two panes stacked on the right.
// This is named `default.kdl`, so a bare `zellij` opens straight into it.
layout {
    pane split_direction="vertical" {
        pane focus=true
        pane split_direction="horizontal" {
            pane
            pane
        }
    }
}
