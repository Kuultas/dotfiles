{
  "$schema": "https://raw.githubusercontent.com/glzr-io/zebar/main/resources/zpack-schema.json",
  "name": "everforest",
  "version": "1.0.0",
  "description": "Everforest glass bar",
  "widgets": [
    {
      "name": "bar",
      "htmlPath": "bar.html",
      "zOrder": "normal",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": false,
      "transparent": true,
      "presets": [
        {
          "name": "default",
          "anchor": "top_center",
          "offsetX": "0px",
          "offsetY": "0px",
          "width": "100%",
          "height": "38px",
          "monitorSelection": { "type": "all" },
          "dockToEdge": { "enabled": true, "edge": "top", "windowMargin": "0px" }
        }
      ]
    }
  ]
}
